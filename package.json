{
  "name": "namori-diary",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "description": "Namori 老师「绘日记」插画浏览、搜索与整理工具（纯前端静态站点）",
  "scripts": {
    "lint": "eslint src scripts tests",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.mjs\"",
    "data": "node scripts/build-index.mjs",
    "data:force": "node scripts/build-index.mjs --force",
    "ocr": "node scripts/ocr-dates.mjs",
    "import": "node scripts/import-images.mjs",
    "import:data": "node scripts/import-data.mjs",
    "dev": "node scripts/build-index.mjs --mode=admin && vite --mode admin",
    "build": "npm run build:admin",
    "build:admin": "node scripts/build-index.mjs --mode=admin && tsc -b && vite build --mode admin",
    "build:public": "node scripts/build-index.mjs --mode=public && tsc -b && vite build --mode public && node scripts/build-static-pages.mjs && node scripts/build-index.mjs --mode=admin",
    "purge": "node scripts/purge-trash.mjs",
    "preview": "vite preview",
    "deploy": "npm run build:public && gh-pages -d dist"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "gh-pages": "^6.2.0",
    "globals": "^15.15.0",
    "prettier": "^3.10.1",
    "sharp": "^0.34.4",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^5.4.11",
    "vitest": "^3.2.7"
  }
}
