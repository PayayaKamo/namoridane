{
  "name": "namori-diary",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Namori 老师「绘日记」插画浏览、搜索与整理工具（纯前端静态站点）",
  "scripts": {
    "data": "node scripts/build-index.mjs",
    "data:force": "node scripts/build-index.mjs --force",
    "ocr": "node scripts/ocr-dates.mjs",
    "import": "node scripts/import-images.mjs",
    "dev": "node scripts/build-index.mjs --mode=admin && vite --mode admin",
    "build": "npm run build:admin",
    "build:admin": "node scripts/build-index.mjs --mode=admin && tsc -b && vite build --mode admin",
    "build:public": "node scripts/build-index.mjs --mode=public && tsc -b && vite build --mode public",
    "purge": "node scripts/purge-trash.mjs",
    "preview": "vite preview",
    "deploy": "npm run build:public && gh-pages -d dist"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "gh-pages": "^6.2.0",
    "sharp": "^0.34.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
